@model SicaiWallet.Web.Models.ViewModels.RefundViewModel

@{
    ViewData["Title"] = "Process Refund";
}

<h1>Process Refund</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5>Purchase Information</h5>

        <p>
            <strong>Student:</strong> @ViewBag.StudentName
        </p>

        <p>
            <strong>Student ID:</strong> @ViewBag.StudentId
        </p>

        <hr />

        <p>
            <strong>Original Purchase:</strong>
            ₡@(((decimal)ViewBag.PurchaseAmount).ToString("N2"))
        </p>

        <p>
            <strong>Already Refunded:</strong>
            ₡@(((decimal)ViewBag.RefundedAmount).ToString("N2"))
        </p>

        <p class="text-success fw-bold">
            Remaining Amount:
            ₡@(((decimal)ViewBag.RemainingAmount).ToString("N2"))
        </p>
    </div>
</div>

<form asp-controller="Wallets" asp-action="Refund" method="post">

    <input type="hidden" asp-for="OriginalTransactionId" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label">
            Refund Amount
        </label>

        <input asp-for="Amount"
               type="number"
               class="form-control"
               step="0.01"
               min="0.01" />

        <span asp-validation-for="Amount"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">
            Description
        </label>

        <input asp-for="Description"
               class="form-control" />

        <span asp-validation-for="Description"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Confirm Refund
    </button>

    <a asp-controller="Wallets"
       asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}