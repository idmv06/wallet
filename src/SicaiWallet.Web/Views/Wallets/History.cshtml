@model IEnumerable<SicaiWallet.Web.Models.WalletTransaction>

@{
    ViewData["Title"] = "Transaction History";
}

<h1>Transaction History</h1>

<div class="mb-4">
    <p><strong>Student:</strong> @ViewBag.StudentName</p>
    <p><strong>Student ID:</strong> @ViewBag.StudentId</p>
    <p>
        <strong>Current Balance:</strong>
        ₡@(((decimal)ViewBag.Balance).ToString("N2"))
    </p>
</div>

<h3>Transactions</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Amount</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5">No transactions found.</td>
            </tr>
        }
        else
        {
            @foreach (var transaction in Model)
            {
                var refundedAmount = transaction.Refunds
                    .Where(refund => refund.Type == SicaiWallet.Web.Models.WalletTransactionType.Refund)
                    .Sum(refund => refund.Amount);

                var remainingAmount = transaction.Amount - refundedAmount;

                <tr>
                    <td>
                        @(transaction.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                    </td>

                    <td>
                        @if (transaction.Type == SicaiWallet.Web.Models.WalletTransactionType.Recharge)
                        {
                            <span class="badge bg-success">Recharge</span>
                        }
                        else if (transaction.Type == SicaiWallet.Web.Models.WalletTransactionType.Purchase)
                        {
                            <span class="badge bg-danger">Purchase</span>
                        }
                        else if (transaction.Type == SicaiWallet.Web.Models.WalletTransactionType.Refund)
                        {
                            <span class="badge bg-info text-dark">Refund</span>
                        }
                    </td>

                    <td>
                        @if (transaction.Type == SicaiWallet.Web.Models.WalletTransactionType.Recharge ||
                             transaction.Type == SicaiWallet.Web.Models.WalletTransactionType.Refund)
                        {
                            <span class="text-success fw-semibold">
                                +₡@transaction.Amount.ToString("N2")
                            </span>
                        }
                        else if (transaction.Type == SicaiWallet.Web.Models.WalletTransactionType.Purchase)
                        {
                            <span class="text-danger fw-semibold">
                                -₡@transaction.Amount.ToString("N2")
                            </span>
                        }
                    </td>

                    <td>
                        @transaction.Description
                    </td>

                    <td>
                        @if (transaction.Type == SicaiWallet.Web.Models.WalletTransactionType.Purchase)
                        {
                            if (remainingAmount > 0)
                            {
                                <a asp-controller="Wallets"
                                   asp-action="Refund"
                                   asp-route-id="@transaction.Id"
                                   class="btn btn-warning btn-sm">
                                    Refund
                                </a>

                                if (refundedAmount > 0)
                                {
                                    <small class="text-muted d-block mt-1">
                                        Remaining: ₡@remainingAmount.ToString("N2")
                                    </small>
                                }
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Fully Refunded
                                </span>
                            }
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<a asp-controller="Wallets"
   asp-action="Index"
   class="btn btn-secondary">
    Back to Wallets
</a>