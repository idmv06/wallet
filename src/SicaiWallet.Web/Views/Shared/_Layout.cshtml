@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SICAI Wallet</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SicaiWallet.Web.styles.css" asp-append-version="true" />
</head>

<body class="app-background">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark sicai-navbar shadow-sm">
            <div class="container-fluid px-4">

                <a class="navbar-brand fw-bold" asp-controller="Dashboard" asp-action="Index">
                    SICAI <span>Wallet</span>
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#sicaiNavbar"
                        aria-controls="sicaiNavbar"
                        aria-expanded="false"
                        aria-label="Alternar navegación">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="sicaiNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Dashboard" ? "active" : "")"
                               asp-controller="Dashboard"
                               asp-action="Index">
                                Panel principal
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Students" ? "active" : "")"
                               asp-controller="Students"
                               asp-action="Index">
                                Estudiantes
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Wallets" ? "active" : "")"
                               asp-controller="Wallets"
                               asp-action="Index">
                                Billeteras
                            </a>
                        </li>

                    </ul>

                    <span class="navbar-text">
                        Sistema de gestión estudiantil
                    </span>

                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container-fluid px-4 py-4 sicai-main">
        @RenderBody()
    </main>

    <footer class="sicai-footer">
        <div class="container-fluid px-4">
            &copy; @DateTime.Now.Year SICAI Wallet
            <span class="mx-2">|</span>
            Sistema de billeteras estudiantiles
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>