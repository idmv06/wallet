@model SicaiWallet.Web.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="mb-4">Dashboard</h1>

<p class="text-muted">
    Welcome to SICAI Wallet. Here's an overview of the system.
</p>

<div class="row g-3 mb-4">

    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="text-muted">Total Students</h6>
                <h2 class="fw-bold">@Model.TotalStudents</h2>
                <span class="text-primary">Registered students</span>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="text-muted">Active Wallets</h6>
                <h2 class="fw-bold">@Model.ActiveWallets</h2>
                <span class="text-success">Active accounts</span>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="text-muted">Total Balance</h6>
                <h2 class="fw-bold">
                    ₡@Model.TotalBalance.ToString("N2")
                </h2>
                <span class="text-primary">Money in wallets</span>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="text-muted">Total Transactions</h6>
                <h2 class="fw-bold">@Model.TotalTransactions</h2>
                <span class="text-secondary">Recorded movements</span>
            </div>
        </div>
    </div>

</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0">Recent Transactions</h5>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Student</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Description</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.RecentTransactions.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4">
                                No transactions found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var transaction in Model.RecentTransactions)
                        {
                            <tr>
                                <td>
                                 @(transaction.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                                </td>

                                <td>
                                    @transaction.WalletAccount.Student.FirstName
                                    @transaction.WalletAccount.Student.LastName
                                </td>

                                <td>
                                    @if (transaction.Type == SicaiWallet.Web.Models.WalletTransactionType.Recharge)
                                    {
                                        <span class="badge bg-success">Recharge</span>
                                    }
                                    else if (transaction.Type == SicaiWallet.Web.Models.WalletTransactionType.Purchase)
                                    {
                                        <span class="badge bg-danger">Purchase</span>
                                    }
                                </td>

                                <td>
                                    @if (transaction.Type == SicaiWallet.Web.Models.WalletTransactionType.Recharge)
                                    {
                                        <span class="text-success fw-semibold">
                                            +₡@transaction.Amount.ToString("N2")
                                        </span>
                                    }
                                    else if (transaction.Type == SicaiWallet.Web.Models.WalletTransactionType.Purchase)
                                    {
                                        <span class="text-danger fw-semibold">
                                            -₡@transaction.Amount.ToString("N2")
                                        </span>
                                    }
                                </td>

                                <td>@transaction.Description</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Students"
       asp-action="Index"
       class="btn btn-outline-primary">
        Manage Students
    </a>

    <a asp-controller="Wallets"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Manage Wallets
    </a>
</div>