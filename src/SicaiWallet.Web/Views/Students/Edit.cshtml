@model SicaiWallet.Web.Models.Student

@{
    ViewData["Title"] = "Editar estudiante";
}

<div class="student-form-page">

    <div class="student-form-heading">
        <span class="students-eyebrow">GESTIÓN ACADÉMICA</span>

        <h1>Editar estudiante</h1>

        <p>
            Modifica la información del estudiante registrado en SICAI Wallet.
        </p>
    </div>

    <div class="student-form-card">

        <div class="student-form-card-header">
            <h4>Información del estudiante</h4>
            <p>Actualiza los datos que deseas modificar.</p>
        </div>

        <div class="student-form-card-body">

            <form asp-controller="Students"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="SicaiStudentId"
                           class="form-label">
                        Carné SICAI
                    </label>

                    <input asp-for="SicaiStudentId"
                           class="form-control form-control-lg"
                           placeholder="Carné del estudiante" />

                    <span asp-validation-for="SicaiStudentId"
                          class="text-warning small"></span>
                </div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="FirstName"
                               class="form-label">
                            Nombre
                        </label>

                        <input asp-for="FirstName"
                               class="form-control form-control-lg"
                               placeholder="Nombre del estudiante" />

                        <span asp-validation-for="FirstName"
                              class="text-warning small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName"
                               class="form-label">
                            Apellido
                        </label>

                        <input asp-for="LastName"
                               class="form-control form-control-lg"
                               placeholder="Apellido del estudiante" />

                        <span asp-validation-for="LastName"
                              class="text-warning small"></span>
                    </div>

                </div>

                <div class="student-form-actions">

                    <button type="submit" class="btn btn-morado">
                        Guardar cambios
                    </button>

                    <a asp-controller="Students"
                       asp-action="Index"
                       class="btn btn-outline-light">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}