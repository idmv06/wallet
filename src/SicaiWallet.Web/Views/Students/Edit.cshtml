@model SicaiWallet.Web.Models.Student

@{
    ViewData["Title"] = "Editar estudiante";
}

<h1>Editar estudiante</h1>

<form asp-controller="Students" asp-action="Edit" asp-route-id="@Model.Id" method="post">

    <input type="hidden" asp-for="Id" />

    <div>
        <label asp-for="SicaiStudentId">Carné SICAI</label>
        <input asp-for="SicaiStudentId" />
        <span asp-validation-for="SicaiStudentId"></span>
    </div>

    <div>
        <label asp-for="FirstName">Nombre</label>
        <input asp-for="FirstName" />
        <span asp-validation-for="FirstName"></span>
    </div>

    <div>
        <label asp-for="LastName">Apellido</label>
        <input asp-for="LastName" />
        <span asp-validation-for="LastName"></span>
    </div>

    <button type="submit">Guardar cambios</button>

</form>

<p>
    <a asp-controller="Students" asp-action="Index">
        Cancelar
    </a>
</p>
