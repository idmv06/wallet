@model List<SicaiWallet.Web.Models.Student>

@{
    ViewData["Title"] = "Estudiantes";
}

<h1>Estudiantes</h1>

<p>
    <a asp-controller="Students" asp-action="Create">
        Registrar nuevo estudiante
    </a>
</p>

@if (Model.Count == 0)
{
    <p>No hay estudiantes registrados.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Carné SICAI</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.Id</td>
                    <td>@student.SicaiStudentId</td>
                    <td>@student.FirstName</td>
                    <td>@student.LastName</td>
                    <td>@(student.IsActive ? "Activo" : "Inactivo")</td>
                </tr>
            }
        </tbody>
    </table>
}
