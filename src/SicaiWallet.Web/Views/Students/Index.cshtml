@model List<SicaiWallet.Web.Models.Student>

@{
    ViewData["Title"] = "Estudiantes";
}

<div class="students-page">

    <div class="students-heading">
        <div>
            <span class="students-eyebrow">GESTIÓN ACADÉMICA</span>
            <h1>Estudiantes</h1>
            <p>Administra los estudiantes registrados en SICAI Wallet.</p>
        </div>

        <a asp-controller="Students"
           asp-action="Create"
           class="btn btn-morado">
            + Registrar estudiante
        </a>
    </div>

    <div class="students-list-card">

        <div class="students-list-header">
            <div>
                <h4>Listado de estudiantes</h4>
                <p>Registro general de estudiantes del sistema</p>
            </div>

            <span class="students-count">
                @Model.Count registrados
            </span>
        </div>

        @if (Model.Count == 0)
        {
            <div class="students-empty">
                <h5>No hay estudiantes registrados</h5>
                <p>Comienza agregando el primer estudiante al sistema.</p>

                <a asp-controller="Students"
                   asp-action="Create"
                   class="btn btn-morado">
                    Registrar estudiante
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table students-table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Carné SICAI</th>
                            <th>Nombre completo</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td>@student.Id</td>

                                <td class="student-code">
                                    @student.SicaiStudentId
                                </td>

                                <td class="student-name">
                                    @student.FirstName @student.LastName
                                </td>

                                <td>
                                    @if (student.IsActive)
                                    {
                                        <span class="student-status status-active">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="student-status status-inactive">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="student-actions">

                                        <a asp-controller="Students"
                                           asp-action="Edit"
                                           asp-route-id="@student.Id"
                                           class="btn btn-sm btn-student-edit">
                                            Editar
                                        </a>

                                        <a asp-controller="Students"
                                           asp-action="Delete"
                                           asp-route-id="@student.Id"
                                           class="btn btn-sm btn-student-delete">
                                            Eliminar
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>

</div>